{
  "manifest_version": 3,
  "name": "YTGuard",
  "version": "0.0.0",
  "description": "Family YouTube controls. Managed by a parent.",
  "minimum_chrome_version": "111",
  "background": { "service_worker": "background.js" },
  "host_permissions": [
    "http://127.0.0.1:7878/*",
    "*://*.youtube.com/*",
    "*://*.youtube-nocookie.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*", "*://*.youtube-nocookie.com/*"],
      "js": ["main-world.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["*://*.youtube.com/*", "*://*.youtube-nocookie.com/*"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
